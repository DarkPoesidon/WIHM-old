# ==============================================================================
# WIHM Configuration Template for Cloudflare Ecosystem (R2, Pages, Calls)
# ==============================================================================

# Server Network Settings
SERVER_PORT=5174
BIND_ADDRESS=0.0.0.0
APP_ENV=production
APP_DEBUG=false

# Allowed Frontend Origins (Cloudflare Pages or Custom Domain)
# This enables CORS and allows cross-origin requests from your Cloudflare Pages UI
APP_PUBLIC_URL=https://WIHM.pages.dev
CORS_ORIGIN=https://WIHM.pages.dev

# Session Cookie Setting
# Use 'None' for cross-domain cookie authentication (e.g. Pages on *.pages.dev + API on render/vps)
# Use 'Lax' if you are using Cloudflare Worker Proxy / custom domain on same origin
COOKIE_SAME_SITE=None

# Database Configuration (PostgreSQL or SQLite)
# For PaaS (Render, Fly.io) with external free Postgres (Neon / Supabase):
DB_CLIENT=postgres
POSTGRES_URL=postgres://user:password@host:5432/WIHM
POSTGRES_SSL=true

# Or for single-node / VPS / persistent volume, use SQLite:
# DB_CLIENT=sqlite3
# DATA_DIR=/app/data

# ------------------------------------------------------------------------------
# 📁 File & Photo Storage via Cloudflare R2 (10 GB Free, Zero Egress Fees)
# ------------------------------------------------------------------------------
FILE_UPLOAD=true
FILE_UPLOAD_MAX_SIZE_MB=25
FILE_UPLOAD_MAX_TOTAL_SIZE_MB=75
FILE_UPLOAD_MAX_FILES=10

# Disable video transcoding to eliminate FFmpeg/CPU overhead in free/light hosting
FILE_UPLOAD_TRANSCODE_VIDEOS=false

# Cloudflare R2 S3-Compatible Driver Settings
STORAGE_DRIVER=remote
STORAGE_ENDPOINT=https://<YOUR_CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_BUCKET=WIHM-uploads
STORAGE_ACCESS_KEY_ID=<YOUR_R2_ACCESS_KEY_ID>
STORAGE_SECRET_ACCESS_KEY=<YOUR_R2_SECRET_ACCESS_KEY>
STORAGE_REGION=auto
STORAGE_FORCE_PATH_STYLE=true

# Auto-configure CORS on R2 bucket for direct browser-to-bucket uploads
STORAGE_AUTO_CORS=true

# ------------------------------------------------------------------------------
# 📞 WebRTC Voice & Video Calls (Peer-to-Peer + Cloudflare Calls TURN)
# ------------------------------------------------------------------------------
CALL="true"
CALL_VIDEO="true"
CALL_MAX_DURATION=0

# Default free STUN server
TURN_STUN_URL=stun:stun.l.google.com:19302

# Cloudflare Calls TURN credentials (Optional, for NAT/firewall traversal)
# Obtain these from: Cloudflare Dashboard -> Calls -> TURN
TURN_TOKEN_ID=""
TURN_API_TOKEN=""
